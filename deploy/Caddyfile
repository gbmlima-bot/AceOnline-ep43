{
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	admin 127.0.0.1:2019
	skip_install_trust
}

{$ACE_DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	@websocket path /play
	handle @websocket {
		reverse_proxy game:9080
	}
	@health path /healthz /readyz
	handle @health {
		reverse_proxy game:9081
	}
	handle {
		respond "ACE Modern dedicated server" 404
	}
}
