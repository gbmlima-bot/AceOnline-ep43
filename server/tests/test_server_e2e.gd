extends SceneTree
## Run in a generated minimal server project after copying this file into tests/.
## A separate production ServerApp process and two real WebSocket connections.
## Invitations are generated by SQLiteStore and remain in this process's memory.
const Store = preload("res://sqlite_store.gd")
const Wire = preload("res://scripts/online/json_wire.gd")
var checks := 0
var failures: Array[String] = []
var store: RefCounted
var pilots: Array[Dictionary] = []
var connections: Array[Dictionary] = []
var tokens: Array[String] = []
var data_dir := ""
var shutdown_file := ""
var server_logs: Array[String] = []
var server_pid := -1
var port := 0
var health_port := 0
var _run_number := 0
var _env_before: Dictionary = {}


func _initialize() -> void:
	_run.call_deferred()


func _run() -> void:
	data_dir="/tmp/ace-server-e2e-%d"%OS.get_process_id()
	shutdown_file=data_dir.path_join("shutdown.flag")
	DirAccess.make_dir_recursive_absolute(data_dir)
	store=Store.new()
	_check(store.open(data_dir.path_join("ace-online.sqlite")),"real SQLite store opens isolated temporary database")
	if not failures.is_empty():
		await _finish()
		return
	for label:String in ["E2E Alpha","E2E Beta"]:
		var pilot:Dictionary=store.issue_pilot(label)
		_check(not pilot.is_empty() and str(pilot.get("token","")).length()==64,"Store creates CSPRNG invitation in memory")
		if pilot.is_empty():
			await _finish()
			return
		pilots.append(pilot)
		tokens.append(pilot.token)
	_select_ports()
	_check(port>0 and health_port>0,"two free localhost TCP ports reserved for fixture")
	if not await _start_server():
		await _finish()
		return
	var health:Dictionary=await _http("/healthz")
	var ready:Dictionary=await _http("/readyz")
	_check(health.get("code")==200 and ready.get("code")==200 and bool(ready.get("body",{}).get("ready",false)),"production health and readiness returnHTTP200")
	var first:=await _open_client(pilots[0].token)
	var second:=await _open_client(pilots[1].token)
	_check(bool(first.get("authenticated",false)) and first.get("pilot_id")==pilots[0].id,"first real WebSocket authenticates persistent pilot")
	_check(bool(second.get("authenticated",false)) and second.get("pilot_id")==pilots[1].id,"second real WebSocket authenticates persistent pilot")
	await _pump(0.3)
	_check(_shared_target_snapshot(first,second),"both independent sockets receive identical shared NPCs at the same server tick")
	_check(int(first.latest.get("player_count",0))==2 and int(second.latest.get("player_count",0))==2,"two players occupy the same authoritative room")
	if first.latest.is_empty() or second.latest.is_empty():
		await _finish()
		return
	var prior_position:Array=_pilot(first,pilots[0].id).get("position",[]).duplicate()
	_send(first,{"op":"input","seq":1,"controls":{"pitch":0.2,"yaw":0.3,"boost":true}})
	_check(await _wait_ack(first,1),"server acknowledges controls only after authoritative input validation")
	await _pump(0.15)
	_check(_pilot(first,pilots[0].id).get("position",[])!=prior_position,"server advances flight from input rather than trusting a client position")
	_send(first,{"op":"input","seq":999,"controls":{"position":[900000,900000,900000],"hp":999999}})
	await _pump(0.15)
	_check(int(first.latest.get("self",{}).get("input_seq",-1))==1,"forged position/resource controls cannot advance accepted input sequence")
	_send(first,{"op":"input","seq":2,"controls":{"brake":true}})
	_check(await _wait_ack(first,2),"valid input remains usable after rejected forged state")
	var native_skill:=_first_skill(first.latest)
	_check(native_skill>0,"server starter training exposes a recovered native skill")
	var original_inventory:Dictionary=first.latest.get("self",{}).get("inventory",{}).duplicate(true)
	var assigned:Dictionary=await _command(first,"e2e-skill-assign","skill_assign",{"slot":2,"item_num":native_skill})
	_check(bool(assigned.get("ok",false)),"real skill assignment completes through server transaction")
	await _pump(0.15)
	_check(_skill_at(first.latest,2)==native_skill,"authoritative snapshot reflects committed hotbar change")
	var persisted:Dictionary=store.get_receipt(pilots[0].id,"e2e-skill-assign")
	_check(not persisted.is_empty() and bool(persisted.get("result",{}).get("ok",false)) and int(persisted.get("revision",0))>0,"command receipt is visible from an independent SQLite connection")
	var replay:Dictionary=await _command(first,"e2e-skill-assign","skill_assign",{"item_num":native_skill,"slot":2})
	_check(replay==assigned,"same request and semantically identical key order replay the original committed result")
	var collision:Dictionary=await _command(first,"e2e-skill-assign","skill_assign",{"slot":3,"item_num":native_skill})
	_check(not bool(collision.get("ok",true)) and collision.get("error")=="request_id_reused","request-ID collision cannot become a different transaction")
	_check(store.get_receipt(pilots[0].id,"e2e-skill-assign")==persisted,"collision cannot overwrite the original SQLite receipt")
	var malformed:Dictionary=await _command(first,"invalid\nrequest","skill_assign",{"slot":2,"item_num":native_skill})
	_check(not bool(malformed.get("ok",true)) and malformed.get("error")=="invalid_command","control characters in request ID are rejected as protocol input")
	var after_bad:Dictionary=await _http("/readyz")
	_check(after_bad.get("code")==200 and OS.is_process_running(server_pid),"malformed request ID does not trigger storage failure or kill server")
	var denied:Dictionary=await _command(first,"e2e-no-unearned-points","allocate_stat",{"stat":"attack","count":1})
	_check(not bool(denied.get("ok",true)),"server refuses allocation of unearned stat points")
	_send(first,{"op":"input","seq":3,"controls":{"brake":true}})
	_check(await _wait_ack(first,3),"failed transaction rollback preserves connected player session")
	await _pump(0.15)
	_check(int(first.latest.get("player_count",0))==2 and _skill_at(first.latest,2)==native_skill,"rollback preserves other player and previous successful changes")
	var inventory_now:Dictionary=first.latest.get("self",{}).get("inventory",{})
	_check(inventory_now.get("credits")==original_inventory.get("credits") and inventory_now.get("bonus_stats")==original_inventory.get("bonus_stats") and inventory_now.get("allocated_stats")==original_inventory.get("allocated_stats"),"network command failures grant no SPI, points or attributes")
	_send(first,{"op":"chat","text":"E2E sessão compartilhada"})
	_check(await _wait_event(second,"chat"),"real session chat crosses the dedicated server to the second player")
	_close(first)
	await _pump(0.15)
	var returning:=await _open_client(pilots[0].token)
	_check(bool(returning.authenticated) and _skill_at(returning.latest,2)==native_skill,"reconnection restores committed character instead of a local checkpoint")
	_check(int(returning.latest.get("self",{}).get("input_seq",-1))==3,"reconnection preserves server input sequence")
	var replay_reconnect:Dictionary=await _command(returning,"e2e-skill-assign","skill_assign",{"slot":2,"item_num":native_skill})
	_check(replay_reconnect==assigned,"reconnection uses the same durable command receipt")
	var before_stop:Dictionary=store.load_room("main")
	_check(int(before_stop.get("revision",0))>0 and before_stop.get("pilots",{}).has(pilots[0].id),"live room and both characters have a persistent aggregate")
	await _stop_server()
	_check(not OS.is_process_running(server_pid),"production shutdown flag exits the server process cleanly")
	var after_stop:Dictionary=store.load_room("main")
	_check(int(after_stop.get("revision",0))>=int(before_stop.get("revision",0)),"graceful shutdown commits final room revision")
	if not await _start_server():
		await _finish()
		return
	var restarted:=await _open_client(pilots[0].token)
	var restarted_two:=await _open_client(pilots[1].token)
	_check(bool(restarted.authenticated) and bool(restarted_two.authenticated),"both stored pilots authenticate after a real process restart")
	_check(_skill_at(restarted.latest,2)==native_skill and int(restarted.latest.get("self",{}).get("input_seq",-1))==3,"restart preserves native skill assignment and input progress")
	var replay_restart:Dictionary=await _command(restarted,"e2e-skill-assign","skill_assign",{"slot":2,"item_num":native_skill})
	_check(replay_restart==assigned,"receipt survives server restart without reapplying operation")
	await _pump(0.15)
	_check(_shared_target_snapshot(restarted,restarted_two),"restarted room still has one shared NPC simulation")
	var rotated:String=store.rotate_token(pilots[0].id)
	_check(rotated.length()==64 and rotated!=pilots[0].token,"operator rotation creates a replacement invitation in memory")
	tokens.append(rotated)
	var deadline:=Time.get_ticks_msec()+6500
	while restarted.peer.get_ready_state()!=WebSocketPeer.STATE_CLOSED and Time.get_ticks_msec()<deadline:await _pump(0.02)
	_check(restarted.peer.get_ready_state()==WebSocketPeer.STATE_CLOSED,"persisted token rotation revokes already-open session within5s recheck")
	var obsolete:=await _open_client(pilots[0].token)
	_check(not bool(obsolete.authenticated) and obsolete.peer.get_ready_state()!=WebSocketPeer.STATE_OPEN,"rotated old invitation cannot authenticate a new connection")
	var current:=await _open_client(rotated)
	_check(bool(current.authenticated) and _skill_at(current.latest,2)==native_skill,"replacement invitation restores same persistent pilot")
	_check(store.authenticate(pilots[0].token).is_empty() and store.authenticate(rotated).get("id")==pilots[0].id,"SQLite accepts only active invitation hash after rotation")
	var metrics:Dictionary=await _http("/metrics")
	_check(metrics.get("code")==200 and int(metrics.get("body",{}).get("storage_failures",-1))==0,"internal metrics stay healthy after malformed messages, retries and restart")
	_check(_no_tokens_in_value(metrics) and _no_tokens_in_value(current.latest),"health metrics and gameplay snapshots never expose plaintext invitations")
	await _finish()


func _select_ports() -> void:
	var one:=TCPServer.new()
	var two:=TCPServer.new()
	for attempt in range(100):
		var candidate:=20000+(OS.get_process_id()*11+attempt*101)%30000
		if one.listen(candidate,"127.0.0.1")==OK:
			if two.listen(candidate+1,"127.0.0.1")==OK:
				port=candidate
				health_port=candidate+1
				one.stop()
				two.stop()
				return
			one.stop()


func _start_server() -> bool:
	DirAccess.remove_absolute(shutdown_file)
	for key:String in ["ACE_DATA_DIR","ACE_BIND_ADDRESS","ACE_PORT","ACE_HEALTH_PORT","ACE_SHUTDOWN_FILE","ACE_MAX_PLAYERS"]:
		if not _env_before.has(key):_env_before[key]=OS.get_environment(key)
	OS.set_environment("ACE_DATA_DIR",data_dir)
	OS.set_environment("ACE_BIND_ADDRESS","127.0.0.1")
	OS.set_environment("ACE_PORT",str(port))
	OS.set_environment("ACE_HEALTH_PORT",str(health_port))
	OS.set_environment("ACE_SHUTDOWN_FILE",shutdown_file)
	OS.set_environment("ACE_MAX_PLAYERS","2")
	_run_number+=1
	var log_path:=data_dir.path_join("server-%d.log"%_run_number)
	server_logs.append(log_path)
	# Static shell code, with all paths supplied as separately quoted arguments.
	# No invitation token is present in process arguments or environment variables.
	server_pid=OS.create_process("/bin/bash",["-c",'exec "$1" --headless --path "$2" > "$3" 2>&1',"ace-e2e-server",OS.get_executable_path(),ProjectSettings.globalize_path("res://"),log_path])
	_check(server_pid>0,"separate production ServerApp process starts")
	var deadline:=Time.get_ticks_msec()+12000
	while Time.get_ticks_msec()<deadline and OS.is_process_running(server_pid):
		var response:Dictionary=await _http("/readyz")
		if response.get("code")==200:return true
		await _pump(0.05)
	_check(false,"production server reaches readiness without source runtime patches")
	return false


func _stop_server() -> void:
	if server_pid<0 or not OS.is_process_running(server_pid):return
	FileAccess.open(shutdown_file,FileAccess.WRITE).store_string("shutdown")
	var deadline:=Time.get_ticks_msec()+5000
	while OS.is_process_running(server_pid) and Time.get_ticks_msec()<deadline:await _pump(0.02)
	if OS.is_process_running(server_pid):
		OS.kill(server_pid)
		_check(false,"graceful production shutdown finishes without forced kill")


func _open_client(token:String) -> Dictionary:
	var peer:=WebSocketPeer.new()
	peer.inbound_buffer_size=32768
	peer.outbound_buffer_size=32768
	var connection:Dictionary={"peer":peer,"authenticated":false,"auth_sent":false,"pilot_id":"","latest":{},"history":{},"results":[],"events":[],"errors":[]}
	connections.append(connection)
	peer.connect_to_url("ws://127.0.0.1:%d/play"%port)
	var deadline:=Time.get_ticks_msec()+5000
	while Time.get_ticks_msec()<deadline and peer.get_ready_state()!=WebSocketPeer.STATE_CLOSED:
		await _pump(0.01)
		if bool(connection.get("hello",false)) and not connection.auth_sent:
			_send(connection,{"op":"auth","protocol":Wire.PROTOCOL,"token":token})
			connection.auth_sent=true
		if connection.authenticated and not connection.latest.is_empty():return connection
	return connection


func _pump(duration:float) -> void:
	var deadline:=Time.get_ticks_msec()+int(duration*1000)
	while true:
		for connection:Dictionary in connections:
			var peer:WebSocketPeer=connection.peer
			peer.poll()
			while peer.get_available_packet_count()>0:
				var value:=Wire.decode(peer.get_packet())
				if value.is_empty():continue
				match str(value.op):
					"hello":connection["hello"]=value.get("protocol")==Wire.PROTOCOL
					"auth_ok":
						connection.authenticated=true
						connection.pilot_id=value.get("pilot_id","")
					"snapshot":
						connection.latest=value.state
						connection.history[str(value.state.get("tick",-1))]=value.state
						if connection.history.size()>120:connection.history.erase(connection.history.keys()[0])
					"result":connection.results.append(value)
					"event":connection.events.append(value.event)
					"error":connection.errors.append(value)
		if Time.get_ticks_msec()>=deadline:return
		await create_timer(0.005).timeout


func _http(path:String) -> Dictionary:
	var peer:=StreamPeerTCP.new()
	peer.connect_to_host("127.0.0.1",health_port)
	var sent:=false
	var data:=PackedByteArray()
	var deadline:=Time.get_ticks_msec()+1000
	while Time.get_ticks_msec()<deadline:
		peer.poll()
		if peer.get_status()==StreamPeerTCP.STATUS_ERROR:break
		if peer.get_status()==StreamPeerTCP.STATUS_CONNECTED:
			if not sent:
				peer.put_data(("GET %s HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"%path).to_utf8_buffer())
				sent=true
			var available:=peer.get_available_bytes()
			if available>0:
				var result:=peer.get_partial_data(available)
				if result[0]==OK:data.append_array(result[1])
				var text:=data.get_string_from_utf8()
				if text.contains("\r\n\r\n"):
					var body:Variant=JSON.parse_string(text.get_slice("\r\n\r\n",1))
					if body is Dictionary:
						peer.disconnect_from_host()
						return {"code":int(text.get_slice(" ",1)),"body":body}
		await _pump(0.01)
	peer.disconnect_from_host()
	return {"code":0,"body":{}}


func _command(connection:Dictionary,request_id:String,action:String,args:Dictionary) -> Dictionary:
	var start_index:int=connection.results.size()
	_send(connection,{"op":"command","request_id":request_id,"action":action,"args":args})
	var deadline:=Time.get_ticks_msec()+3000
	while Time.get_ticks_msec()<deadline:
		await _pump(0.02)
		for index in range(start_index,connection.results.size()):
			var result:Dictionary=connection.results[index]
			if result.get("request_id")==request_id:
				await _pump(0.12) # Commands stay below the deployed transport limiter.
				return result
	return {}


func _wait_ack(connection:Dictionary,sequence:int) -> bool:
	var deadline:=Time.get_ticks_msec()+3000
	while Time.get_ticks_msec()<deadline:
		if int(connection.latest.get("self",{}).get("input_seq",-1))==sequence:return true
		await _pump(0.01)
	return false


func _wait_event(connection:Dictionary,type:String) -> bool:
	var deadline:=Time.get_ticks_msec()+3000
	while Time.get_ticks_msec()<deadline:
		for event:Dictionary in connection.events:
			if event.get("type")==type:return true
		await _pump(0.01)
	return false


func _send(connection:Dictionary,value:Dictionary) -> bool:
	return (connection.peer as WebSocketPeer).send_text(Wire.encode(value))==OK


func _close(connection:Dictionary) -> void:
	if connection.peer.get_ready_state()==WebSocketPeer.STATE_OPEN:connection.peer.close(1000,"fixture_reconnect")


func _shared_target_snapshot(one:Dictionary,two:Dictionary) -> bool:
	for key:String in one.history:
		if two.history.has(key):
			var a:Dictionary=one.history[key]
			var b:Dictionary=two.history[key]
			if int(a.get("player_count",0))==2 and int(b.get("player_count",0))==2 and a.get("targets",[]).size()==3 and a.targets==b.targets:return true
	return false


func _pilot(connection:Dictionary,identifier:String) -> Dictionary:
	for value:Dictionary in connection.latest.get("pilots",[]):
		if value.get("id")==identifier:return value
	return {}


func _first_skill(state:Dictionary) -> int:
	for slot:Dictionary in state.get("self",{}).get("skills",{}).get("hotbar",[]):
		if int(slot.get("item_num",0))>0:return int(slot.item_num)
	return 0


func _skill_at(state:Dictionary,index:int) -> int:
	for slot:Dictionary in state.get("self",{}).get("skills",{}).get("hotbar",[]):
		if int(slot.get("slot",-1))==index:return int(slot.get("item_num",0))
	return 0


func _no_tokens_in_value(value:Variant) -> bool:
	var text:=JSON.stringify(value)
	for token:String in tokens:
		if text.contains(token):return false
	return true


func _no_tokens_in_file(path:String) -> bool:
	var file:=FileAccess.open(path,FileAccess.READ)
	if file==null:return false
	var tail:=PackedByteArray()
	while not file.eof_reached():
		var bytes:=tail+file.get_buffer(65536)
		var hex:=bytes.hex_encode()
		for token:String in tokens:
			if hex.contains(token.to_utf8_buffer().hex_encode()):return false
		tail=bytes.slice(maxi(0,bytes.size()-63))
	file.close()
	return true


func _check(value:bool,label:String) -> void:
	checks+=1
	if not value:failures.append(label)


func _finish() -> void:
	await _stop_server()
	for connection:Dictionary in connections:
		_close(connection)
	await _pump(0.05)
	for log_path:String in server_logs:
		_check(FileAccess.file_exists(log_path) and _no_tokens_in_file(log_path),"production process log never contains plaintext invitations")
		if FileAccess.file_exists(log_path):
			var text:=FileAccess.get_file_as_string(log_path)
			_check(not ("SCRIPT ERROR" in text or "ERROR:" in text),"production server log has no parse/runtime errors")
			if not failures.is_empty():
				for token:String in tokens:text=text.replace(token,"[redacted]")
				print("SERVER_E2E_DIAGNOSTIC="+text.right(2500))
	if store!=null:store.close()
	for name:String in ["ace-online.sqlite","ace-online.sqlite-wal","ace-online.sqlite-shm"]:
		var path:=data_dir.path_join(name)
		if FileAccess.file_exists(path):_check(_no_tokens_in_file(path),"database/WAL contain hashes rather than plaintext invitations")
	for key:String in _env_before:OS.set_environment(key,_env_before[key])
	var directory:=DirAccess.open(data_dir)
	if directory!=null:
		for name:String in directory.get_files():DirAccess.remove_absolute(data_dir.path_join(name))
		DirAccess.remove_absolute(data_dir)
	print("SERVER_E2E="+JSON.stringify({"checks":checks,"failures":failures,"real_server_process":true,"independent_websocket_clients":2,"real_sqlite":true,"restart_tested":_run_number>=2,"tokens_logged":false}))
	for failure:String in failures:printerr(failure)
	quit(0 if failures.is_empty() else 1)
