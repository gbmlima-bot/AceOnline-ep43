extends SceneTree
## Current Arena against a save generated by the actual pinned v0.8 scripts.
const Arena = preload("res://scripts/online/arena_model.gd")
const World = preload("res://scripts/online/headless_world.gd")
var world: RefCounted
var checks := 0
var failures: Array[String] = []

func _initialize() -> void:
	world = World.new()
	_check(world.configure(3002), "Native world failed configuration")
	var args := OS.get_cmdline_user_args()
	if args.size() != 1:
		_check(false, "Pass actual v0.8 fixture path")
	else:
		var old: Variant = JSON.parse_string(FileAccess.get_file_as_string(args[0]))
		_check(old is Dictionary, "Actual historical JSON fixture is unreadable")
		if old is Dictionary:
			_test_real_v08(old)
	_test_hostile_rounds_and_burst_checkpoint()
	print("ARENA_MIGRATION_TEST=" + JSON.stringify({"checks": checks, "failures": failures, "historical_commit": "c7a18413cf13383876a00db77ad724ffb02158f8", "native_hornian_weapon": 7500020, "hostile_rounds_and_burst_restart": true}))
	for failure: String in failures:
		push_error(failure)
	quit(0 if failures.is_empty() else 1)

func _check(condition: bool, message: String) -> void:
	checks += 1
	if not condition:
		failures.append(message)

func _arena() -> RefCounted:
	var arena = Arena.new()
	_check(arena.configure({"room_id": "migration-v08", "seed": 12345, "max_players": 2}, world), "Current native NPC arena failed configuration")
	return arena

func _test_real_v08(old: Dictionary) -> void:
	_check(not old.has("combat_state_version") and not old.targets[0].has("npc_weapon_options") and not old.pilots.alice.combat.player.has("life"), "Fixture was approximated from current state instead of real v0.8")
	_check(old.projectiles.size() > 0 and old.rewarded.size() > 0 and old.contributions.size() > 0, "Actual v0.8 fixture lacks in-flight missile/reward/contribution state")
	var arena = _arena()
	_check(arena.import_state(old), "Real v0.8 room failed strict migration")
	if arena.pilots.size() != 2:
		return
	_check(arena.tick == int(old.tick) and arena.combat._rng_state == int(old.rng_state) and arena.combat._next_projectile_id == int(old.next_projectile_id), "Migration changed authoritative clock, RNG or projectile sequence")
	_check(arena._rewarded == old.rewarded and arena._commands == old.commands, "Migration changed reward/command replay ledgers")
	for id: String in ["alice", "bob"]:
		var prior: Dictionary = Arena._unpack(old.pilots[id].combat).player
		var after: Dictionary = arena.combat.pilot_states[id].player
		for field: String in ["hp", "shield", "primary_ammo", "secondary_ammo", "primary_cooldown", "secondary_cooldown", "credits"]:
			_check(Arena._same_values(after[field], prior[field]), "Migration reset pilot resource: " + id + "/" + field)
		_check(int(after.life) == 0 and Arena._same_values(JSON.parse_string(JSON.stringify(arena.pilots[id].skills.export_state())), old.pilots[id].skills), "Legacy player life or skill timers were not preserved/defaulted narrowly")
		_check(Arena._same_values(Arena._capture_flight(arena.pilots[id].flight).position, old.pilots[id].flight.position), "Migration changed old flight pose")
		_check(bool(arena.add_player(id).ok) and not bool(arena.submit_input(id, int(old.pilots[id].seq), {}).ok), "Old input sequence was reset on migration/reconnect")
	for index in range(3):
		var prior: Dictionary = Arena._unpack(old.targets[index])
		var after: Dictionary = arena.combat.targets[index]
		for field: String in ["hp", "shield", "position", "spawn_position", "velocity", "life", "attack_cooldown", "respawn_remaining", "aggressed"]:
			_check(Arena._same_values(after[field], prior[field]), "Migration changed NPC live state: " + field)
		_check(int(after.weapon.item_num) == 7500020 and after.npc_weapon_options.size() == 1 and int(after.npc_burst_remaining) == 0, "Legacy NPC did not receive verified native weapon/default scheduler")
	_check(arena.combat.projectiles.size() == old.projectiles.size(), "Migration discarded real old missiles")
	for index in range(old.projectiles.size()):
		var prior: Dictionary = Arena._unpack(old.projectiles[index])
		var after: Dictionary = arena.combat.projectiles[index]
		for field: String in ["id", "pilot_id", "position", "direction", "target_id", "target_life", "remaining", "traveled"]:
			_check(Arena._same_values(after[field], prior[field]), "Migration changed existing friendly round: " + field)
		_check(not bool(after.hostile) and after.weapon.has("cycle_seconds"), "Old friendly round gained hostile routing or lacked normalized cycle field")
	_check(not arena._legacy_contribution_lives.is_empty(), "Legacy boolean contribution lost explicit missing-damage policy")
	arena.advance(0.05)
	_check(arena.tick > int(old.tick), "Migrated state could not advance through new NPC/projectile contract")
	var saved: Dictionary = JSON.parse_string(JSON.stringify(arena.export_state()))
	var restored = _arena()
	_check(restored.import_state(saved), "Migrated room did not survive its first new-schema restart")

func _live_hostile_fixture() -> RefCounted:
	var arena = _arena()
	arena.add_player("alice")
	arena.add_player("bob")
	for id: String in ["alice", "bob"]:
		arena.pilots[id].flight.position = Vector3(0 if id == "alice" else 900, 1500, 0)
		arena.pilots[id].flight.profile_ready = false
	for index in range(3):
		var target: Dictionary = arena.combat.targets[index]
		target.position = Vector3(0, 1500, -100 - index * 1000)
		target.spawn_position = target.position
		target.speed = 0.0
		target.hostile = index == 0
		target.aggressed = index == 0
		target.attack_cooldown = 0.0
	for frame in range(100):
		arena.advance(0.01)
		if arena.combat.projectiles.size() > 0 and int(arena.combat.targets[0].npc_burst_remaining) > 0:
			return arena
	return arena

func _test_hostile_rounds_and_burst_checkpoint() -> void:
	var arena = _live_hostile_fixture()
	_check(not arena.combat.projectiles.is_empty() and int(arena.combat.targets[0].npc_burst_remaining) > 0, "Native Hornian never produced a hostile missile during its real burst")
	if arena.combat.projectiles.is_empty():
		return
	var round_value: Dictionary = arena.combat.projectiles[0]
	_check(bool(round_value.hostile) and round_value.pilot_id == "alice" and round_value.target_life == arena.combat.pilot_states.alice.player.life and int(round_value.weapon.item_num) == 7500020, "Native hostile missile lost intended victim/life or verified ITEM")
	var before_bob: Dictionary = arena.combat.pilot_states.bob.player.duplicate(true)
	var saved: Dictionary = JSON.parse_string(JSON.stringify(arena.export_state()))
	var restored = _arena()
	_check(restored.import_state(saved), "Active native burst and hostile missile failed restart")
	if restored.pilots.size() != 2:
		return
	var paused_rounds: Array = Arena._pack(restored.combat.projectiles)
	arena.remove_player("alice")
	arena.remove_player("bob")
	for frame in range(15):
		arena.advance(0.01)
		restored.advance(0.01)
	_check(Arena._same_values(Arena._pack(restored.combat.projectiles), paused_rounds), "Restart tick before authentication advanced or discarded private incoming missiles")
	for id: String in ["alice", "bob"]:
		arena.add_player(id)
		restored.add_player(id)
	_check(Arena._same_values(restored.combat.projectiles, arena.combat.projectiles) and restored.combat.targets[0].npc_burst_remaining == arena.combat.targets[0].npc_burst_remaining and Arena._same_values(restored.combat.targets[0].npc_option_ready_at, arena.combat.targets[0].npc_option_ready_at), "Restart reset active hostile routing, pending burst or absolute cooldowns")
	for frame in range(40):
		arena.advance(0.01)
		restored.advance(0.01)
	_check(arena.combat._rng_state == restored.combat._rng_state and Arena._same_values(arena.combat.pilot_states.alice.player, restored.combat.pilot_states.alice.player), "Restart changed subsequent native burst damage/RNG")
	_check(arena.combat.pilot_states.bob.player.hp == before_bob.hp and arena.combat.pilot_states.bob.player.shield == before_bob.shield, "Hostile missile damaged another pilot instead of its intended victim")
	var stable: Dictionary = restored.export_state()
	for corruption: String in ["victim", "future_life", "weapon", "burst", "timer", "ready_key", "missing_field"]:
		var bad := saved.duplicate(true)
		match corruption:
			"victim": bad.projectiles[0].pilot_id = "unknown"
			"future_life": bad.projectiles[0].target_life = 999
			"weapon": bad.projectiles[0].weapon.minimum = 99999.0
			"burst": bad.targets[0].npc_burst_remaining = 999
			"timer": bad.targets[0].npc_prepare_remaining = NAN
			"ready_key": bad.targets[0].npc_option_ready_at = {"unknown": 1.0}
			"missing_field": bad.targets[0].erase("npc_burst_wait")
		_check(not restored.import_state(bad) and restored.export_state() == stable, "Invalid NPC/hostile persistence mutated live room: " + corruption)
	var dead_attacker = _live_hostile_fixture()
	dead_attacker.combat.targets[0].dead = true
	dead_attacker.combat.targets[0].hp = 0.0
	dead_attacker.combat.targets[0].respawn_remaining = 12.0
	var dead_saved: Dictionary = JSON.parse_string(JSON.stringify(dead_attacker.export_state()))
	var dead_restored = _arena()
	_check(dead_restored.import_state(dead_saved) and not dead_restored.combat.projectiles.is_empty(), "Death of firing NPC discarded an already-launched native missile on restart")
	dead_restored.add_player("alice")
	dead_restored.add_player("bob")
	var random_before := int(dead_restored.combat._rng_state)
	dead_restored.advance(0.08)
	_check(dead_restored.combat.projectiles.is_empty() and dead_restored.combat._rng_state != random_before, "Native missile from a dead NPC failed to reach intended victim/attack resolution")
	var stale = _live_hostile_fixture()
	var stale_round: Dictionary = stale.combat.projectiles[0]
	var victim: Dictionary = stale.combat.pilot_states.alice.player
	victim.life += 1
	victim.dead = false
	victim.hp = victim.max_hp
	victim.shield = victim.max_shield
	var prior_hp: float = victim.hp
	var prior_shield: float = victim.shield
	stale.advance(0.01)
	_check(not stale.combat.projectiles.has(stale_round) and stale.combat.pilot_states.alice.player.hp == prior_hp and stale.combat.pilot_states.alice.player.shield == prior_shield, "Stale hostile life token damaged a respawned character")
